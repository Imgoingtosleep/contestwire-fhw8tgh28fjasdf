################################################################################
# News & Video Contest Platform — Template Configuration (.env.example)
# คัดลอกไฟล์นี้เป็น ".env" แล้วกรอกค่าคอนฟิกจริงของคุณ
################################################################################

# ==========================================
# 1. General & Ports
# ==========================================
NODE_ENV=development
FRONTEND_PORT=9000
BACKEND_PORT=9100
POSTGRES_PORT=5432

# ==========================================
# 2. PostgreSQL Database
# ==========================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_postgres_secure_password
POSTGRES_DB=news_contest_db

# ==========================================
# 3. Backend Application
# ==========================================
PORT=9100
JWT_SECRET=your_jwt_secret_random_key_here
MAX_UPLOAD_SIZE_MB=50

# ==========================================
# 4. Object Storage (S3-Compatible)
# ==========================================
R2_ACCOUNT_ID=your_storage_account_id
R2_ACCESS_KEY_ID=your_storage_access_key_id
R2_SECRET_ACCESS_KEY=your_storage_secret_access_key
R2_BUCKET_NAME=your_storage_bucket_name
R2_PUBLIC_URL=https://your-public-cdn-url.com

# ==========================================
# 5. Domain & CORS Configuration
# ==========================================
CORS_ORIGIN=http://localhost:9000

# ==========================================
# 6. Frontend (React Environment Variables)
# ==========================================
REACT_APP_API_URL=http://localhost:9100/api
REACT_APP_SITE_NAME=โตโยต้า ถนนสีขาว

# ==========================================
# 7. Dev Hot Reload (File Watching)
# ==========================================
# โค้ดอยู่บนดิสก์ Windows (/mnt/c) หรือ macOS bind mount → inotify ไม่ทำงานข้ามเข้า container
# ตั้งเป็น true เพื่อให้ watcher ใช้การ poll แทน (กิน CPU เล็กน้อย แต่ hot reload ทำงาน)
# ถ้าย้ายโค้ดไปไว้ในไฟล์ระบบ Linux แล้ว ตั้งเป็น false ได้เพื่อประหยัด CPU
WATCH_POLLING=true
# ระยะ poll (ms) — ค่ายิ่งต่ำยิ่งไว แต่กิน CPU มากขึ้น
WATCH_INTERVAL=800

# ==========================================
# 8. Feature Flags
# ==========================================
# ช่วงนี้เปิดใช้เป็นเว็บข่าวก่อน ยังไม่รับข้อมูลจากผู้ใช้
# false = ฟอร์มสมัครยังเปิดดูได้ แต่กรอกและส่งไม่ได้ และ /api/contest,
#         /api/upload ตอบ 503 (ปิดช่องที่ดึงข้อมูลผู้สมัครไปด้วย)
# ต้องตั้งให้ตรงกันทั้งสองตัว ไม่งั้นฟอร์มจะเปิดให้กรอกแต่ส่งไม่ผ่าน
CONTEST_OPEN=false
REACT_APP_CONTEST_OPEN=false

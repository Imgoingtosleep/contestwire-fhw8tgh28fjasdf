################################################################################
# Production Configuration — คัดลอกเป็น ".env.production" บนเซิร์ฟเวอร์
# แล้วกรอกค่าจริง (ห้าม commit ไฟล์ที่กรอกค่าแล้วเข้า git)
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
################################################################################

# ==========================================
# 1. โดเมนและใบรับรอง TLS
# ==========================================
# โดเมนหลัก ไม่ต้องใส่ https:// และไม่ต้องใส่ www
DOMAIN=example.com
# อีเมลสำหรับแจ้งเตือนใบรับรองใกล้หมดอายุ
ACME_EMAIL=admin@example.com
# true = ขอใบทดสอบ (ไม่ติดลิมิต 5 ครั้ง/สัปดาห์) ใช้ตอนลองครั้งแรก
# เมื่อผ่านแล้วเปลี่ยนเป็น false แล้วรัน init-ssl.sh ใหม่เพื่อขอใบจริง
ACME_STAGING=false

# ==========================================
# 2. General
# ==========================================
NODE_ENV=production

# ==========================================
# 3. PostgreSQL
# ==========================================
# ฐานข้อมูลไม่เปิดพอร์ตออกอินเทอร์เน็ต แต่ยังต้องตั้งรหัสผ่านที่เดายาก
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=news_contest_db

# ==========================================
# 4. Backend
# ==========================================
# สุ่มค่าด้วย: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string
MAX_UPLOAD_SIZE_MB=50
# ต้องตรงกับโดเมนจริง ไม่ใช้ * ในโปรดักชัน
CORS_ORIGIN=https://example.com,https://www.example.com

# ==========================================
# 5. Object Storage (S3-Compatible)
# ==========================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ==========================================
# 6. Frontend
# ==========================================
# เว้นเป็น /api เพื่อเรียกผ่านโดเมนเดียวกัน ไม่ต้องเปิดพอร์ต backend ออกภายนอก
# และไม่เจอปัญหา CORS หรือ mixed content
REACT_APP_API_URL=/api
REACT_APP_SITE_NAME=โตโยต้า ถนนสีขาว

# ==========================================
# 7. Feature Flags
# ==========================================
# ช่วงนี้เปิดใช้เป็นเว็บข่าวก่อน ยังไม่รับข้อมูลจากผู้ใช้
# false = ฟอร์มสมัครยังเปิดดูได้ แต่กรอกและส่งไม่ได้ และ /api/contest,
#         /api/upload ตอบ 503 (ปิดช่องที่ดึงข้อมูลผู้สมัครไปด้วย)
# ต้องตั้งให้ตรงกันทั้งสองตัว ไม่งั้นฟอร์มจะเปิดให้กรอกแต่ส่งไม่ผ่าน
CONTEST_OPEN=false
REACT_APP_CONTEST_OPEN=false

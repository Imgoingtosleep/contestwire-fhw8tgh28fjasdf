################################################################################
# Tunnel Configuration — คัดลอกเป็น ".env.tunnel" แล้วกรอกค่าจริง
# (ห้าม commit ไฟล์ที่กรอกค่าแล้วเข้า git)
#
#   docker compose -f docker-compose.tunnel.yml --env-file .env.tunnel up -d --build
#   ./scripts/tunnel-url.sh
#
# ชุดนี้ใช้เปิดเว็บให้คนนอกเข้าดูได้ทันทีโดยยังไม่ต้องมีโดเมน
# ไม่มีพอร์ตใดถูกเปิดออกสู่อินเทอร์เน็ตจากเครื่องนี้เลย
################################################################################

# ==========================================
# 1. General
# ==========================================
NODE_ENV=production

# ==========================================
# 2. PostgreSQL
# ==========================================
# ฐานข้อมูลไม่เปิดพอร์ตออกนอกเครือข่าย Docker แต่ยังต้องตั้งรหัสผ่านที่เดายาก
POSTGRES_USER=change_me
POSTGRES_PASSWORD=change_me_to_a_long_random_string
POSTGRES_DB=news_contest_db

# ==========================================
# 3. Backend
# ==========================================
# สุ่มค่าด้วย: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string

# แผนฟรีของ tunnel จำกัดขนาด request body ที่ 100 MB — ตั้งเกินกว่านั้นไม่มีผล
# ไฟล์ใหญ่กว่านี้ต้องใช้ POST /api/upload/presign แล้วอัปตรงเข้าที่เก็บไฟล์
MAX_UPLOAD_SIZE_MB=50

# frontend เรียก API ผ่านโดเมนเดียวกัน (same-origin) จึงไม่ต้องระบุโดเมนของ tunnel
# ซึ่งดีเพราะ URL ของ quick tunnel เปลี่ยนทุกครั้งที่รีสตาร์ต
CORS_ORIGIN=*

# ==========================================
# 4. Object Storage (S3-Compatible)
# ==========================================
# เว้นว่างได้ ระบบยังรันปกติ แต่ endpoint อัปโหลดจะตอบ 503
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ==========================================
# 5. Frontend
# ==========================================
# ต้องเป็น /api เท่านั้นสำหรับชุดนี้ เพราะเรียกผ่านโฮสต์เดียวกับหน้าเว็บ
REACT_APP_API_URL=/api
REACT_APP_SITE_NAME=โตโยต้า ถนนสีขาว

# ==========================================
# 6. Tunnel
# ==========================================
# เว้นว่างไว้ = quick tunnel (ไม่ต้องมีบัญชี ได้ URL ชั่วคราว *.trycloudflare.com)
# เมื่อย้าย DNS ของโดเมนมาที่ Cloudflare แล้ว ค่อยเอา token จากหน้า Zero Trust
# มาใส่ที่นี่ แล้วสลับบรรทัด command ใน docker-compose.tunnel.yml ตามคอมเมนต์
TUNNEL_TOKEN=
